# Rename this file to secrets.yaml and fill in your own values.
# secrets.yaml is already listed in .gitignore so it never gets committed.

# A fresh, random 32-byte base64 key for the ESPHome API Noise encryption.
# Generate one with:  openssl rand -base64 32
api_encryption_key: "CHANGE_ME_GENERATE_YOUR_OWN_KEY_abcdefghijk="

# DNS domain suffix for the device, e.g. ".fritz.box" for a FRITZ!Box
# network, or ".local" for plain mDNS. Must start with a dot.
network_domain: ".local"
